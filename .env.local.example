# Copy this file to .env.local and fill in real values from your Supabase project.
# https://supabase.com/dashboard → your project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Single shared secret protecting the operator dashboard.
# Anyone who knows /admin/<this-value> can control the queue. Keep it private.
ADMIN_SECRET=change-me-to-something-long-and-random

# The publicly visible URL of your deployed app, used to build the QR code.
# Local dev: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
